# 复制为 .env 使用（.env 不入库）
ENV=dev
DEBUG=true

DB_URL=mysql+pymysql://root:bizsys123@127.0.0.1:3307/bizsys?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# 生产环境必须更换为随机强密钥
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_HOURS=12

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 反向代理链（真实客户端 IP —— 审计日志要记访问者的公网 IP）
# 受控代理跳数：从 X-Forwarded-For 右侧往左数。本项目部署 = 上层网关 + 容器 nginx = 2 跳
TRUSTED_PROXY_HOPS=2
# 总开关：关掉则一律用 TCP 对端地址（不使用任何代理头）
TRUST_PROXY_HEADERS=true
# 可选：显式受信任代理的 IP/CIDR（逗号分隔）。填了则以网段判定（优先于跳数），
# 例：TRUSTED_PROXY_CIDRS=172.16.0.5/32,172.17.0.0/16
TRUSTED_PROXY_CIDRS=
